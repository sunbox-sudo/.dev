#!/usr/bin/env bash

# Initialize default variables for this setup script.
# desktopShell: the desktop/window manager to use.
# update: whether package updates should run.
# stow: whether dotfiles should be deployed with GNU stow.
# timezone: system timezone to enforce.
# verbose: enables additional logging output.
# errorRuned: simple error counter used during script termination.
#os=""
desktopShell="hyprland" 
update=1
stow=1
runWM=0
timezone="Europe/Stockholm"
verbose=0
errorRuned=0

# Logging helpers
log(){
	if [ "$verbose" -eq 1 ]; then
		echo "Log: $*"
	fi
}
warn(){
	echo "Warn: $*"
}
error(){
	echo "Error: $*" >&2
	((errorRuned++))
	# If an error occurs, exit immediately after updating the counter.
	if [ "$errorRuned" -ge 1 ]; then
		exit 1
	fi
	cd "$execPath" || error "Couldn't cd to $execPath"
	exit 1
}

# Flags and args

# Help text displayed when the script is invoked with --help or invalid flags.
usage(){
	echo "usage: $0 [OPTIONS]"
	echo "Options:"
	#echo "  -O, --OS <arch>
	echo "  -D, --desktop-shell <hyprland>   	Your WM/DE you use"
	echo "  -u, --no-update 				Don't update "
	echo "  -s, --no-stow 				Don't stow"
	echo "  -w, --run-wm 				Run WM setup"
	echo "  -v, --verbose				Enables verbose"
	echo "  -h, --help				Show this message"
	exit 1
}

PAutostartRSED_ARGS=$(getopt --options D:uswvh \
	--longoptions desktop-shell:,no-update,no-stow,run-wm,verbose,help \
	--name "$0" -- "$@")

if [ $? -ne 0 ]; then
	# getopt failed (invalid flags)
	usage
fi

eval set -- "$PARSED_ARGS"

# Parse command-line flags and update configuration variables.
while true; do
	case "$1" in
		-D | --desktop-shell)
			desktopShell="$2";
			shift 2
			;;
		-u | --no-update)
			update=0;
			shift
			;;
		-s | --no-stow)
			stow=0;
			shift
			;;
		-w | --run-wm)
			runWM=1;
			shift
			;;
		-v | --verbose)
			verbose=1;
			shift
			;;
		-h | --help)
			usage;
			shift
			;;
		--) 
			shift;
			break
			;;
		*)
			error "Unexpected flag $1";
			usage
			;;
	esac
done


# Validate requierd flags
#if [ -z "$desktopShell" ]; then
#	echo "Error: --desktop-shell are requierd" >&2
#	exit 1
#fi

# Validate desktop shell selection.
case "$desktopShell" in
	hyprland)
		;;
	*)
		error "Invalid desktop shell: $desktopShell"
		usage
		;;
	esac

# Log initial startup values when verbose mode is enabled.
log "Desktop Shell: $desktopShell"
log "Update: $update"
log "Stow: $stow"
log "Run WM: $runWM"
log "Timezone: $timezone"
log "Verbose: $verbose"

# Main logic begins here.
execPath=$(pwd)
wantedTimezone="$timezone"

# Change timezone if needed
_currentTimezone=$(timedatectl show --property=Timezone --value)
if [ "$_currentTimezone" != "$wantedTimezone" ] ; then
	timedatectl set-timezone "$wantedTimezone"
fi

if [ "$update" -eq 1 ]; then
	log "Download sequence - Started"
	# Update system packages and refresh the package database.
	sudo pacman -Syu --noconfirm
	yay -Syu --noconfirm
	# Ensure the keyboard layout is set to Swedish.
	setxkbmap se 

	# Install required user packages if they are not already present.
	sudo pacman -S --noconfirm --needed git \
		spotify-launcher \
		curl \
		kitty \
		fastfetch \
		qutebrowser \
		noto-fonts-emoji \
		eza \
		feh \
		cmatrix \
		go \
		stow \
		|| error "pacman couldn't install packages"

	yay -Syu --noconfirm --needed \
		dorion-bin \
		|| error "yay couldn't install packages" 

	log "Download sequence - Done"
else
	log "Download sequense - Skipped"
fi

if [ "$stow" -eq 1 ]; then
	log "Stow sequence - Started"
	# Navigate to the dotfiles repository and sync the latest changes.
	cd "$HOME/env/.dotfiles" || error "Couldn't cd to dotfiles"
 
	git pull origin main

	# Remove any previously stowed files before reapplying dotfiles.
		stow -D -t "$HOME" . || error "Couldn't Delete stow"

	if [ "$verbose" -eq 1 ] ; then
		eza -a 
	fi

	# Create symlinks from the dotfiles repository into the home directory.
	stow -t "$HOME" ./ || error "Couldn't stow"
	log "Stow sequence - Done"
else
	log "Stow sequense - Skipped"
fi

cd "$execPath" || error "Couldn't cd to $execPath"

# Execute the selected desktop shell script if enabled.
if [ "$runWM" -eq 1 ]; then
	scriptDir=$(cd "$(dirname "$0")" && pwd)
	dsScript="$scriptDir/wm/hyprland"

	if [ -f "$dsScript" ]; then
		log "Executing desktop shell script: $dsScript"
		bash "$dsScript" "$@" || error "Failed to execute $dsScript"
	else
		error "Desktop shell script not found: $dsScript"
	fi
else
	log "WM setup - Skipped (use -w to enable)"
fi

# Log end
log "Profile generated at $(date)"
log "Positional arguments remaining (if any): $*" # Show leftover (if any)

