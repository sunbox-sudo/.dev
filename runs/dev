#!/usr/bin/env bash

set -uo pipefail

###############################################################################
# Default configuration
###############################################################################

desktopShell="hyprland"
update=1
stowEnabled=1
runWM=0
timezone="Europe/Stockholm"
verbose=0

###############################################################################
# Logging
###############################################################################

log() {
    if [[ "$verbose" -eq 1 ]]; then
        printf '[LOG] %s\n' "$*"
    fi
}

warn() {
    printf '[WARN] %s\n' "$*" >&2
}

error() {
    printf '[ERROR] %s\n' "$*" >&2
    exit 1
}

###############################################################################
# Usage
###############################################################################

usage() {
    cat <<EOF
Usage: $0 [OPTIONS]

Options:
  -D, --desktop-shell <hyprland>  Desktop shell/window manager
  -u, --no-update                 Skip package updates/installations
  -s, --no-stow                   Skip GNU stow deployment
  -w, --run-wm                    Run WM setup script
  -v, --verbose                   Enable verbose logging
  -h, --help                      Show this help message

Examples:
  $0
  $0 -u
  $0 -w
  $0 -D hyprland -w
EOF
}

###############################################################################
# Argument parsing
###############################################################################

parse_args() {
    local parsed_args

    parsed_args=$(
        getopt \
            --options D:uswvh \
            --longoptions desktop-shell:,no-update,no-stow,run-wm,verbose,help \
            --name "$0" \
            -- "$@"
    ) || {
        usage
        exit 1
    }

    eval set -- "$parsed_args"

    while true; do
        case "$1" in
            -D|--desktop-shell)
                desktopShell="$2"
                shift 2
                ;;
            -u|--no-update)
                update=0
                shift
                ;;
            -s|--no-stow)
                stowEnabled=0
                shift
                ;;
            -w|--run-wm)
                runWM=1
                shift
                ;;
            -v|--verbose)
                verbose=1
                shift
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            --)
                shift
                break
                ;;
            *)
                error "Unexpected argument: $1"
                ;;
        esac
    done
}

###############################################################################
# Validation
###############################################################################

validate_config() {
    case "$desktopShell" in
        hyprland)
            ;;
        *)
            error "Unsupported desktop shell: $desktopShell"
            ;;
    esac
}

###############################################################################
# Timezone
###############################################################################

configure_timezone() {
    local current_timezone

    if ! command -v timedatectl >/dev/null 2>&1; then
        warn "timedatectl not found, skipping timezone configuration"
        return
    fi

    current_timezone=$(timedatectl show --property=Timezone --value)

    if [[ "$current_timezone" != "$timezone" ]]; then
        log "Changing timezone: $current_timezone -> $timezone"
        sudo timedatectl set-timezone "$timezone" \
            || error "Failed to set timezone"
    else
        log "Timezone already set to $timezone"
    fi
}

###############################################################################
# Package management
###############################################################################

update_system() {
    [[ "$update" -eq 1 ]] || {
        log "Package update skipped"
        return
    }

    log "Package update sequence started"

    sudo pacman -Syu --noconfirm \
        || error "pacman system update failed"

    if command -v yay >/dev/null 2>&1; then
        yay -Syu --noconfirm \
            || error "yay system update failed"
    else
        warn "yay not installed, skipping AUR updates"
    fi

    if command -v setxkbmap >/dev/null 2>&1; then
        setxkbmap se || warn "Failed to set keyboard layout"
    fi

    sudo pacman -S --noconfirm --needed \
        git \
        curl \
        kitty \
        fastfetch \
        noto-fonts-emoji \
        eza \
        feh \
        cmatrix \
        go \
        stow \
        || error "Failed installing pacman packages"

    if command -v yay >/dev/null 2>&1; then
        yay -S --noconfirm --needed \
		vesktop-git \
		zen-browser-bin \
		|| error "Failed installing AUR packages"
    fi

    log "Package update sequence completed"
}

###############################################################################
# Dotfiles
###############################################################################

deploy_dotfiles() {
    [[ "$stowEnabled" -eq 1 ]] || {
        log "Stow sequence skipped"
        return
    }

    local dotfiles_dir="$HOME/env/.dotfiles"

    log "Stow sequence started"

    [[ -d "$dotfiles_dir" ]] \
        || error "Dotfiles directory not found: $dotfiles_dir"

    cd "$dotfiles_dir" \
        || error "Failed to enter $dotfiles_dir"

    git pull origin main \
        || error "git pull failed"

    stow -D -t "$HOME" . \
        || error "Failed removing previous stow links"

    if [[ "$verbose" -eq 1 ]]; then
        eza -a
    fi

    stow -t "$HOME" . \
        || error "Failed creating stow links"

    log "Stow sequence completed"
}

###############################################################################
# Window manager setup
###############################################################################

run_window_manager_setup() {
    [[ "$runWM" -eq 1 ]] || {
        log "WM setup skipped"
        return
    }

    local script_dir
    local wm_script

    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    wm_script="$script_dir/wm/hyprland"

    [[ -f "$wm_script" ]] \
        || error "WM script not found: $wm_script"

    log "Executing WM script: $wm_script"

    bash "$wm_script" \
        || error "WM setup failed"
}

###############################################################################
# Main
###############################################################################

main() {
    local execPath

    execPath="$(pwd)"

    parse_args "$@"
    validate_config

    log "Desktop Shell : $desktopShell"
    log "Update        : $update"
    log "Stow          : $stowEnabled"
    log "Run WM        : $runWM"
    log "Timezone      : $timezone"
    log "Verbose       : $verbose"

    configure_timezone
    update_system
    deploy_dotfiles

    cd "$execPath" \
        || error "Failed returning to original directory"

    run_window_manager_setup

    log "Finished at $(date)"
}

main "$@"
